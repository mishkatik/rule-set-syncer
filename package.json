{
  "name": "rule-set-syncer",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build --compile --minify --sourcemap src/index.ts --outfile out/rule-set-syncer",
