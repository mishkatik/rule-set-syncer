# Cron expression for sync schedule (default: every hour)
CRON_SCHEDULE=0 * * * *

# Optional prefix prepended to every S3 key (e.g. "mirror/")
S3_KEY_PREFIX=

# S3 credentials — required
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# S3 endpoint — required for non-AWS providers (e.g. Cloudflare R2, MinIO)
S3_ENDPOINT=

# S3 region (default: us-east-1)
S3_REGION=
