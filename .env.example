# Cron expression for sync schedule (default: every hour)
CRON_SCHEDULE=0 * * * *

# Optional prefix prepended to every S3 key (e.g. "mirror/")
S3_KEY_PREFIX=

# S3 credentials — required
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# S3 endpoint — required for non-AWS providers (e.g. Cloudflare R2, MinIO)
S3_ENDPOINT=

# S3 region (default: us-east-1)
S3_REGION=

# Telegram notifications — optional. Set both the bot token and chat id to
# receive a summary message after each sync (only when something changed or
# failed — unchanged runs stay silent). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional forum topic (message thread) id to post into
TELEGRAM_TOPIC_ID=
